{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/panta/:path*", "destination": "https://live-api.panta.market/api/v1/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}